PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/learniq
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
CLIENT_URL=http://localhost:5173
UPLOAD_PATH=./uploads

# Resend (used to send the forgot-password reset link email)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=LearnIQ <onboarding@resend.dev>

# Email (Nodemailer via Gmail SMTP) - used to send the forgot-password
# reset link to ANY recipient, no domain needed.
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (choose "Mail" as the app) - it gives you a 16-character password.
# 3. EMAIL_USER = that Gmail address, EMAIL_PASS = the 16-character App
#    Password (not your normal Gmail password).
# Leave EMAIL_FROM unset (or set it to "LearnIQ <EMAIL_USER's address>") -
# Gmail requires the From address to match the authenticated account.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=LearnIQ <your_email@gmail.com>

# Razorpay (Optional - test keys or live keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# Optional: enables the server-to-server payment webhook used as a safety net for the Olympiad fee
# (set the same secret in Razorpay Dashboard -> Webhooks; URL: https://<your-domain>/api/olympiad/payments/webhook, event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Olympiad exams (Standards 4-10). The question papers do not state a duration - set each one here before the first start-up (default 60).
OLYMPIAD_1_DURATION_MINUTES=60
OLYMPIAD_2_DURATION_MINUTES=60
OLYMPIAD_3_DURATION_MINUTES=60
OLYMPIAD_4_DURATION_MINUTES=60
OLYMPIAD_5_DURATION_MINUTES=60
OLYMPIAD_6_DURATION_MINUTES=60
OLYMPIAD_7_DURATION_MINUTES=60
OLYMPIAD_8_DURATION_MINUTES=60
OLYMPIAD_9_DURATION_MINUTES=60
OLYMPIAD_10_DURATION_MINUTES=60

# Live Streaming / WebRTC
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Admin Seed
ADMIN_EMAIL=learniq.admin@gmail.com
ADMIN_PASSWORD=Nikhil@1710

# Resend Email API
RESEND_API_KEY=your_resend_api_key
