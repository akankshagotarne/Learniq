PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/learniq
# JWT_SECRET signs every login token. In production the server REFUSES TO START if it is missing, a placeholder, or
# shorter than 16 characters (use 32+). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
# CORS: the ONLY browser origin(s) allowed to call this API (also used in password-reset links).
# Production: your exact frontend URL, e.g. https://your-app.vercel.app . Several origins -> comma-separated.
# localhost dev origins are allowed automatically when NODE_ENV is not "production".
CLIENT_URL=http://localhost:5173
# Optional: how long a signed link to paid lecture videos / PDFs stays valid (minutes, default 360)
MEDIA_URL_TTL_MINUTES=360
UPLOAD_PATH=./uploads

# Resend (used to send the forgot-password reset link email)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=LearnIQ <onboarding@resend.dev>

# Email (Nodemailer via Gmail SMTP) - used to send the forgot-password
# reset link to ANY recipient, no domain needed.
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (choose "Mail" as the app) - it gives you a 16-character password.
# 3. EMAIL_USER = that Gmail address, EMAIL_PASS = the 16-character App
#    Password (not your normal Gmail password).
# Leave EMAIL_FROM unset (or set it to "LearnIQ <EMAIL_USER's address>") -
# Gmail requires the From address to match the authenticated account.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Razorpay — Dashboard → Account & Settings → API Keys (test keys: rzp_test_…, live keys: rzp_live_…)
# Backend only (backend/.env locally, Render → Environment in production). NEVER put the secret in the frontend.
# Use the SAME key id for the frontend's VITE_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: enables the server-to-server payment webhook used as a safety net for the Olympiad fee
# (set the same secret in Razorpay Dashboard -> Webhooks; URL: https://<your-domain>/api/olympiad/payments/webhook, event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Olympiad exams (Standards 4-10). The question papers do not state a duration - set each one here before the first start-up (default 60).
OLYMPIAD_1_DURATION_MINUTES=60
OLYMPIAD_2_DURATION_MINUTES=60
OLYMPIAD_3_DURATION_MINUTES=60
OLYMPIAD_4_DURATION_MINUTES=60
OLYMPIAD_5_DURATION_MINUTES=60
OLYMPIAD_6_DURATION_MINUTES=60
OLYMPIAD_7_DURATION_MINUTES=60
OLYMPIAD_8_DURATION_MINUTES=60
OLYMPIAD_9_DURATION_MINUTES=60
OLYMPIAD_10_DURATION_MINUTES=60

# Live Streaming / WebRTC
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Admin Seed
# Used only by `npm run seed` (local/dev). ADMIN_PASSWORD must be 12+ characters. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password for the demo teacher/student accounts the seed creates (leave blank = random, accounts unusable)
SEED_DEMO_PASSWORD=

# Resend Email API
RESEND_API_KEY=your_resend_api_key

# ─────────────────────────────────────────────────────────────────────────────
# AI Interview (included with a purchased Olympiad exam) — see docs/AI_INTERVIEW.md
# BACKEND ONLY: never copy these into the frontend / Vercel and never prefix them with VITE_.
# Local: put the real values in backend/.env (git-ignored). Production: add the same names in Render -> Environment.
# Missing REQUIRED values => the interview shows "not available right now" (no fake interview is ever produced).
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED (3; OPENAI_API_KEY only needed while AI_INTERVIEW_PROVIDER=openai or for OpenAI speech-to-text) ── secrets: enter ONLY in backend/.env locally and in Render -> Environment; never in the repo or in chat
# OpenAI secret key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# HeyGen LiveAvatar API key (https://www.liveavatar.com). Alias accepted: HEYGEN_API_KEY
LIVEAVATAR_API_KEY=
# NOT a secret, but required: the avatar id to use (from the LiveAvatar dashboard).
# For the first free sandbox test use the sandbox avatar id: dd73ea75-1218-4ef3-92ce-606d5f7fbc0a
HEYGEN_AVATAR_ID=

# ── OPTIONAL: which model is the interviewer's brain (questions, answer evaluation, final feedback) ──
# openai (default) = production. ollama = LOCAL DEVELOPMENT ONLY (free, runs on your own computer); it is REFUSED when NODE_ENV=production.
# Only the exact value "ollama" selects Ollama; anything else (or leaving this out) uses OpenAI. It does not change the avatar.
# NOTE: speech-to-text is chosen separately (AI_INTERVIEW_STT_PROVIDER below): in ollama mode it still defaults to OpenAI Realtime (OPENAI_API_KEY + credit).
AI_INTERVIEW_PROVIDER=openai
# Used only when AI_INTERVIEW_PROVIDER=ollama (no key needed):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_REQUEST_TIMEOUT_MS=60000
# How long Ollama keeps the model loaded after a request (Ollama's own default is 5m; reloading Gemma can take 10-40 s on a laptop).
# The backend also starts loading the model when an interview is opened, so the first question is not slowed down by a cold start.
OLLAMA_KEEP_ALIVE=30m

# ── OPTIONAL: speech-to-text (the student's spoken answers -> text, live subtitles) ──
# openai (default) = OpenAI Realtime, used in production. local = LOCAL DEVELOPMENT ONLY: the faster-whisper service in /local-stt running on your own
# computer (free, English only); it is REFUSED when NODE_ENV=production. Only the exact value "local" selects it; anything else (or nothing) = OpenAI.
AI_INTERVIEW_STT_PROVIDER=openai
# Used only when AI_INTERVIEW_STT_PROVIDER=local (setup: local-stt/README.md). The address must be on THIS computer (127.0.0.1 / localhost / [::1]).
LOCAL_STT_URL=ws://127.0.0.1:8765
LOCAL_STT_MODEL=base.en

# ── OPTIONAL: avatar voice / context overrides (leave empty to use the avatar's defaults) ──
HEYGEN_VOICE_ID=
HEYGEN_CONTEXT_ID=
# Free test mode (one fixed avatar, sessions of about 1 minute, no credits spent). Use "true" for the FIRST local test, "false" for real use.
LIVEAVATAR_SANDBOX=false
# Longest single avatar session your LiveAvatar plan allows, in seconds (Free = 120, Starter = 300, Essential = 1200). Leave empty for no cap.
# Without it, the session asks for the interview length + 90 s and LiveAvatar rejects it when that is above your plan's limit.
LIVEAVATAR_MAX_SESSION_SECONDS=
# How many avatar sessions one interview may use (default 6). When a capped avatar session ends, ONLY the avatar is reconnected
# (speech-to-text keeps running); if it cannot come back, the interview continues with subtitles instead of stopping.
# AI_INTERVIEW_MAX_AVATAR_SESSIONS=6

# ── OPTIONAL: interview rules (defaults shown; safe to leave as they are) ──
AI_INTERVIEW_ENABLED=true
AI_INTERVIEW_MAX_QUESTIONS=8
AI_INTERVIEW_MAX_DURATION_SECONDS=420
AI_INTERVIEW_PASS_PERCENTAGE=60
# One interview per purchase, consumed when the FIRST QUESTION has been presented. Re-starts are only allowed when nothing was
# consumed (failure before question 1) or after a clearly technical failure with no real answer; this caps how many (cost guard).
AI_INTERVIEW_MAX_TECHNICAL_RETRIES=5
AI_INTERVIEW_MODEL=gpt-4.1-mini
AI_INTERVIEW_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_INTERVIEW_LANGUAGE=en

# ── OPTIONAL: timing and provider endpoints (defaults shown; leave commented unless you need to change them) ──
# AI_INTERVIEW_SILENCE_TIMEOUT_MS=15000
# AI_INTERVIEW_END_OF_ANSWER_SILENCE_MS=1400
# AI_INTERVIEW_AI_TIMEOUT_MS=20000
# AI_INTERVIEW_AVATAR_TIMEOUT_MS=15000
# AI_INTERVIEW_CLIENT_SECRET_TTL_SECONDS=600
# OPENAI_BASE_URL=https://api.openai.com/v1
# LIVEAVATAR_API_URL=https://api.liveavatar.com
